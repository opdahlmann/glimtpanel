# Glimtpanel – mal for miljøvariabler. Kopier til .env (Docker lokalt) og .env.dev (hub og web direkte på maskinen).
# Verdiene til Dokploy ligger i infra/<app>/.env.dev og .env.prod. Kun denne filen sjekkes inn. Alle nøkler har prefiks GLIMT_.

# --- Felles ---
GLIMT_ENV=development                      # development | e2e | production
GLIMT_DEFAULT_LANG=en                      # en | no
GLIMT_FEATURE_FLAGS=                       # kommaseparert: textmode,snapshot,share,compact,whatsnew,certs,containersPage,crossLogs,twofa,pause

# --- Database (kun huben) ---
GLIMT_MONGO_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin
GLIMT_MONGO_DB=GlimtpanelDev

# --- Hub ---
GLIMT_HUB_URL=http://localhost:5080        # adressen Kestrel lytter på (0.0.0.0:8080 i container)
GLIMT_HUB_PUBLIC_URL=http://localhost:5080 # offentlig adresse, brukes i installasjonsskript og agent-URL
GLIMT_HUB_INTERNAL_URL=http://localhost:5080 # adressen web-proxyen (nginx / ng serve) sender /api og /hub til
GLIMT_WEB_PUBLIC_URL=http://localhost:4200 # lenker i e-post og push
GLIMT_INSTALL_URL=http://localhost:5080/install
GLIMT_DOCS_URL=https://github.com/opdahlmann/glimtpanel#readme
GLIMT_JWT_SECRET=CHANGE-ME-64-random-bytes-base64
GLIMT_BUFFER_PATH=./.local/buffer          # /data/buffer i container (volum)
GLIMT_HEARTBEAT_SECONDS=30
GLIMT_DOWN_AFTER_SECONDS=120
GLIMT_DEMO_MODE=false                      # true starter falske servere på demo-kontoen og /demo i web (må være true i produksjon)
GLIMT_AGENT_VERSION=0.1.0                  # versjonen /install peker på
GLIMT_AGENT_IMAGE=ghcr.io/opdahlmann/glimt-agent:latest   # sidecar-imaget i snuttene fra «Add container»

# --- E-post via appmail (eiers tjeneste, Brevo bak). Tom URL i utvikling logger e-posten til konsollen ---
GLIMT_APPMAIL_URL=
GLIMT_APPMAIL_API_KEY=
GLIMT_MAIL_FROM=Glimtpanel <no-reply@glimtpanel.com>

# --- Web Push (VAPID). Lag nøkler med: dotnet run --project apps/glimt-hub/src/Glimt.Hub -- vapid-keys ---
GLIMT_VAPID_PUBLIC=
GLIMT_VAPID_PRIVATE=
GLIMT_VAPID_SUBJECT=mailto:you@example.com

# --- Kun utvikling (GLIMT_ENV=development) ---
GLIMT_DEV_ENROL_KEY=gp_dev_local           # evig innrulleringsnøkkel for agent-containeren
GLIMT_DEV_USER_EMAIL=dev@glimtpanel.local  # utviklerkonto som seedes i GlimtpanelDev
GLIMT_DEV_USER_PASSWORD=GlimtDev-2026!
GLIMT_DEV_CONTAINER_TOKEN=agt_dev_sidecar_token_change_me   # containernoden sidecar-dev på dev-kontoen (npm run dev -- --sidecar)

# --- Agent-container (npm run dev) ---
GLIMT_AGENT_HUB_WS=ws://host.docker.internal:5080/agent/ws
GLIMT_AGENT_NAME=ubuntu-dev

# --- Web ---
GLIMT_WEB_PORT=4200                        # 80 i container
