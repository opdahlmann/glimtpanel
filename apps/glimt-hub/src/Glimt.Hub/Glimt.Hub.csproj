<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <RootNamespace>Glimt.Hub</RootNamespace>
        <AssemblyName>Glimt.Hub</AssemblyName>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <!-- Steg 11.4: workstation GC. Server GC (standard for ASP.NET) la 100 agenter på 1,2 GB RSS med én heap per kjerne;
             huben er liten og latensfølsom bare i sekundskala, så én konkurrerende heap holder RSS langt under 1 GB. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
        <PackageReference Include="MessagePack" Version="3.1.8" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.12" />
        <PackageReference Include="MongoDB.Driver" Version="3.11.1" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Glimt.Hub.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!-- Agentens installasjonsskript serveres av GET /install (steg 11.3): get.glimtpanel.com peker hit. -->
        <EmbeddedResource Include="..\..\..\glimt-agent\install\install.sh" LogicalName="install.sh" />
    </ItemGroup>

</Project>
